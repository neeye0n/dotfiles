{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/logo/neon.txt",
    "color": {
      "1": "#63d5d3",
      "2": "#63cccb",
      "3": "",
      "4": "",
      "5": "",
      "6": "",
      "7": "",
      "8": "",
      "9": ""
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#80d5d3",
      "title": "#b0cccb"
    },
    "temp": {
      "unit": "D",
      "ndigits": 1,
      "color": {
        "green": "32",
        "yellow": "93",
        "red": "91"
      }
    },
    "percent": {
      "color": {
        "green": "#b2c8e8",
        "yellow": "#80d5d3",
        "red": "#ffb4ab"
      }
    },
    "bar": {
      "color": {
        "elapsed": "auto",
        "total": "97",
        "border": "97"
      }
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "key": "╭───────────────────────────────────╮"
    },
    {
      "type": "kernel",
      "key": "│   kernel",
      "format": "{release>22} {#keys}│"
    },
    {
      "type": "command",
      "key": "│   uptime",
      "text": "uptime -p | cut -d ' ' -f 2-",
      "format": "{>22} {#keys}│"
    },
    {
      "type": "shell",
      "key": "│   shell ",
      "format": "{pretty-name>22} {#keys}│"
    },
    {
      "type": "command",
      "key": "│   mem   ",
      "text": "free -m | awk 'NR==2{printf \"%.2f GiB / %.2f GiB\",$3/1024,$2/1024}'",
      "format": "{>22} {#keys}│"
    },
    {
      "type": "packages",
      "key": "│   pkgs  ",
      "format": "{all>22} {#keys}│"
    },
    {
      "type": "command",
      "key": "│   user  ",
      "text": "echo $USER",
      "format": "{>22} {#keys}│"
    },
    {
      "type": "command",
      "key": "│   hname ",
      "text": "hostnamectl hostname",
      "format": "{>22} {#keys}│"
    },
    {
      "type": "os",
      "key": "│ 󰻀  distro",
      "format": "{pretty-name>22} {#keys}│"
    },
    {
      "type": "custom",
      "key": "╰───────────────────────────────────╯"
    },
    "break",
    "break"
  ]
}
