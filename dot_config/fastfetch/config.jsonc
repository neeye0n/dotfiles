{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/logo/neon.txt",
    "padding": {
      "top": 1,
      "left": 2
    },
    "color": {
      "1": "#ffb463",
      "2": "#e7bd63"
    }
  },
  "display": {
    "separator": "",
    "key": {
      "width": 9
    },
    "bar": {
      "color": {
        "elapsed": "auto",
        "total": "97",
        "border": "97"
      }
    },
    "color": {
      "keys": "#ffb4a6",
      "title": "#e7bdb5"
    },
    "percent": {
      "color": {
        "green": "#ddc48c",
        "yellow": "#ffb4a6",
        "red": "#ffb4ab"
      }
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "key": "╭────────────────────────────────╮"
    },
    {
      "type": "os",
      "key": "│ 󰻀 DIST ",
      "format": "{pretty-name>24} {#keys}│"
    },
    {
      "type": "os",
      "key": "│  KER ",
      "format": "{kernel-release>24} {#keys}│"
    },
    {
      "type": "packages",
      "key": "│ 󰮯 PAC ",
      "format": "lua:local a = ...; local s = a.pacman .. ' packages'; local n = 24; s = s:sub(1, n); s = string.rep(' ', math.max(0, n - #s)) .. s; return s .. ' \\27[95m│\\27[0m'"
    },
    {
      "type": "wm",
      "key": "│ 󰧨 WM ",
      "format": "lua:local a = ...; local s = a.prettyName .. ' ' .. a.version; local n = 24; s = s:sub(1, n); s = string.rep(' ', math.max(0, n - #s)) .. s; return s .. ' \\27[95m│\\27[0m'"
    },
    {
      "type": "lm",
      "key": "│ 󰍂 LM ",
      "format": "{pretty-name>24} {#keys}│"
    },
    {
      "type": "terminal",
      "key": "│  TERM",
      "format": "lua:local a = ...; local s = a.prettyName .. ' ' .. a.version; local n = 24; s = s:sub(1, n); s = string.rep(' ', math.max(0, n - #s)) .. s; return s .. ' \\27[95m│\\27[0m'"
    },
    {
      "type": "shell",
      "key": "│  SH ",
      "format": "lua:local a = ...; local s = a.prettyName .. ' ' .. a.version; local n = 24; s = s:sub(1, n); s = string.rep(' ', math.max(0, n - #s)) .. s; return s .. ' \\27[95m│\\27[0m'"
    },
    {
      "type": "cpu",
      "key": "│ 󰍛 CPU  ",
      "format": "{name>24} {#keys}│"
    },
    {
      "type": "gpu",
      "key": "│ 󰘚 GPU  ",
      "format": "{name>24} {#keys}│"
    },
    {
      "type": "memory",
      "key": "│  RAM  ",
      "format": "lua:local a = ...; local s = a.used .. ' / ' .. a.total; local n = 24; s = s:sub(1, n); s = string.rep(' ', math.max(0, n - #s)) .. s; return s .. ' \\27[95m│\\27[0m'"
    },
    {
      "type": "custom",
      "key": "╰────────────────────────────────╯"
    },
    "break"
  ]
}
